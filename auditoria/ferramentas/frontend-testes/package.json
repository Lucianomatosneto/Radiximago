{
  "name": "radix-auditoria-frontend-testes",
  "private": true,
  "description": "Vitest (testes de funções) e Playwright (testes no navegador) da Central de Auditoria. Isolado: não altera o frontend.",
  "scripts": {
    "vitest": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "cobertura": "vitest run --config vitest.config.ts --coverage && node ajustar-lcov.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "30.1.3",
    "vitest": "^5.1.0"
  }
}
