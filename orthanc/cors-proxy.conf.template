# Proxy reverso so pra tratar CORS na frente do Orthanc.
#
# O Orthanc exige autenticacao (AuthenticationEnabled=true) e nao envia
# Access-Control-Allow-Origin em nenhuma resposta (nem 200, nem 401) -
# confirmado testando com curl. Como o preflight (OPTIONS) do navegador
# nunca carrega credenciais, ele sempre bateria 401 direto no Orthanc.
#
# Este proxy responde o preflight sozinho (sem repassar pro Orthanc, sem
# exigir auth) e injeta os cabecalhos CORS em toda resposta repassada.
# So afeta trafego de navegador - o backend Python continua falando com
# o Orthanc direto na rede interna (radix-orthanc:8042), sem passar aqui.
#
# Access-Control-Allow-Credentials e obrigatorio aqui: o cliente DICOMweb
# do OHIF manda as requisicoes com withCredentials=true (confirmado via
# teste manual de XHR), e o navegador exige esse cabecalho sempre que
# withCredentials e usado - mesmo com Allow-Origin ja apontando pra uma
# origem especifica (nao pode ser "*" junto com credentials de qualquer
# forma, mas so isso nao bastava).
#
# O Authorization e injetado AQUI (pelo proxy) - e SO depois da portaria
# abaixo aprovar o pedido -, nao pelo app-config.js do
# OHIF: no ohif/app v3.9.2, o cliente QIDO/WADO (extensions/default/src/
# DicomWebDataSource/index.js) monta os headers via
# userAuthenticationService.getAuthorizationHeader() - o campo
# "requestOptions.auth" do dataSources nao e lido em lugar nenhum nessa
# versao (confirmado lendo o codigo-fonte real da tag v3.9.2 no Github).
# Sem OIDC configurado esse servico sempre retorna vazio, entao a unica
# forma pratica de autenticar e o proprio proxy adicionar a credencial -
# o que tambem tem a vantagem de nunca expor a senha do Orthanc no
# JS/config que chega ao navegador.

# Allowlist de origens locais equivalentes (localhost e 127.0.0.1 apontam
# pro mesmo host, mas o navegador trata como origens CORS diferentes).
map $http_origin $cors_origin {
    default '';
    "~^http://localhost:3001$" $http_origin;
    "~^http://127\.0\.0\.1:3001$" $http_origin;
}

# PORTARIA (OWASP ASVS 5.0 - V8.2.2/V8.3.1): antes de repassar QUALQUER
# pedido ao Orthanc, o Nginx pergunta ao backend do Radix se quem esta
# pedindo pode ver aquela imagem (auth_request). O navegador manda junto o
# cookie de login do Radix (o OHIF usa withCredentials). Sem login: 401;
# sem permissao: 403; so com 2xx o pedido segue (e so entao a senha do
# Orthanc e acrescentada). Regras: backend/app/core/acesso_imagens.py.
# Antes disso, qualquer pessoa que alcancasse a porta 8042 via (e podia
# apagar) todas as imagens, sem login.

server {
    listen 80;

    # ENDERECOS SEMPRE ATUALIZADOS (20/10/2026): o Nginx, por padrao, descobre
    # o endereco do radix-api e do radix-orthanc UMA vez, ao ligar, e guarda
    # para sempre. Quando o radix-api era reiniciado ele podia ganhar outro
    # endereco na rede interna do Docker, e a portaria batia na porta antiga
    # ("Connection refused") - o visualizador mostrava "Something went
    # wrong". Com o endereco numa variavel, o Nginx pergunta de novo ao DNS
    # interno do Docker (127.0.0.11) a cada 10 s.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # consulta interna ao backend (o navegador nao consegue chamar direto)
    location = /_radix_autorizar {
        internal;
        set $radix_api radix-api;
        proxy_pass http://$radix_api:8000/visualizador/autorizar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
    }

    location / {
        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 3600 always;
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain' always;
            return 204;
        }

        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;

        # o preflight (OPTIONS, acima) responde antes desta checagem
        auth_request /_radix_autorizar;

        # com variavel e sem caminho, o endereco pedido segue igual ao original
        set $radix_orthanc radix-orthanc;
        proxy_pass http://$radix_orthanc:8042;
        # $host remove a porta da requisicao original - o Orthanc usa esse
        # header pra montar RetrieveURL nas respostas DICOMweb, e sem a porta
        # elas saiam como "http://localhost/..." (porta 80 implicita, errada).
        # $http_host preserva exatamente o que o navegador mandou (localhost:8042).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Basic __ORTHANC_AUTH_BASIC__";
    }
}
