POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=radix_imago
DATABASE_URL=postgresql://user:password@radix-postgres:5432/radix_imago

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# sessao renovada enquanto em uso; limite absoluto desde o login (horas)
SESSAO_MAXIMA_HORAS=12

ORTHANC_URL=http://radix-orthanc:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

OHIF_URL=http://radix-ohif
DICOMWEB_URL=http://radix-orthanc:8042/dicom-web

# Aparelhos de raio X da rede (etapa D): nome DICOM do Radix (o mesmo vai
# para o Orthanc), porta DICOM e o IP deste computador na rede da clinica/
# faculdade (aparece na tela "Aparelhos da rede" para configurar o aparelho)
ORTHANC_AET=RADIXIMAGO
DICOM_PORTA=4242
DICOM_ENDERECO_SERVIDOR=

# Chave dos identificadores das imagens anonimizadas (UIDs fixos: cortes de uma
# tomografia no mesmo exame; arquivo repetido reconhecido). Gerar UMA VEZ com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# e guardar junto com as copias de seguranca: trocar a chave faz o Radix deixar
# de reconhecer as imagens ja recebidas.
ANONIMIZACAO_CHAVE_UID=
# Modo desafio - resultados para a pesquisa (24/11/2026): so liguem depois
# do TCLE aprovado pelo comite de etica. Os dois juntos; cada estudante ainda
# precisa aceitar a versao do TCLE.
DESAFIO_REGISTRO_ATIVO=false
TCLE_PESQUISA_VERSAO=

ENVIRONMENT=development

# chave do servico de voz (API <-> radix-whisper), 64 caracteres aleatorios:
#   python -c "import secrets; print(secrets.token_hex(32))"
WHISPER_CHAVE=
