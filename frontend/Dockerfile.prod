# Frontend do Radix Imago para a INTERNET (docker-compose.prod.yml).
# Diferente do Dockerfile (desenvolvimento, "npm run dev"): aqui o site e
# COMPILADO uma vez ("next build") e servido ja pronto ("next start") -
# mais rapido, menos memoria e sem as ferramentas de desenvolvimento.
#
# Os enderecos publicos da API e do visualizador entram NA COMPILACAO
# (o Next.js grava as variaveis NEXT_PUBLIC_* dentro do codigo enviado ao
# navegador e na politica de seguranca - next.config.mjs).

# --- etapa 1: compilar ---
FROM node:20-alpine AS compilacao
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_OHIF_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_OHIF_URL=$NEXT_PUBLIC_OHIF_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev

# --- etapa 2: rodar (so o necessario, usuario sem privilegios) ---
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=compilacao --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
